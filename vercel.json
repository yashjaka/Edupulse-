{
  "buildCommand": "pnpm --filter @workspace/edupulse run build",
  "outputDirectory": "artifacts/edupulse/dist/public",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
