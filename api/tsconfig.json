{
  "compilerOptions": {
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": true,
    "noEmit": false,
    "noEmitOnError": false,
    "types": ["node"]
  },
  "include": ["index.ts", "../artifacts/api-server/src/**/*.ts"]
}
